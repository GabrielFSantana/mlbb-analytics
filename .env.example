# ---------------------------------------------------------------------
# MLBB Analytics - exemplo de configuracao.
# Copie para .env e preencha. NUNCA faca commit do .env real.
# ---------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------
# Credenciais usadas pelo container do Postgres (docker compose).
POSTGRES_USER=mlbb
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=mlbb

# URL usada pelo backend. Dentro do docker compose o host e "postgres".
# Rodando o backend localmente (fora do docker), use "localhost".
DATABASE_URL=postgresql+psycopg://mlbb:troque-esta-senha@postgres:5432/mlbb

# --- Discord ----------------------------------------------------------
# Token do bot (Discord Developer Portal > Bot > Reset Token).
DISCORD_TOKEN=
# ID do servidor. Com ele os slash commands aparecem na hora (sync por guild).
DISCORD_GUILD_ID=
# Canal onde o job de meta publicara atualizacoes (Fase 2).
DISCORD_META_CHANNEL_ID=

# --- Bot -> Backend ---------------------------------------------------
# Dentro do docker compose o host e "backend".
BACKEND_API_URL=http://backend:8000

# --- Fonte de dados MLBB ---------------------------------------------
# "mock" e a unica implementacao disponivel na Fase 1.
MLBB_PROVIDER=mock
